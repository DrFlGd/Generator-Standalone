{
  "name": "led-lightbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "esbuild tests/geometry.test.ts --bundle --platform=node --format=esm --external:manifold-3d --outfile=tests/.geometry-test.mjs --log-level=error && node tests/.geometry-test.mjs"
  },
  "dependencies": {
    "@vostok/brand": "workspace:*",
    "@vostok/export": "workspace:*",
    "@vostok/manifold": "workspace:*",
    "@vostok/plates": "workspace:*",
    "@vostok/shapes": "workspace:*",
    "@vostok/trace": "workspace:*",
    "@vostok/ui-kit": "workspace:*",
    "@vostok/viewer": "workspace:*",
    "manifold-3d": "^3.5.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "esbuild": "^0.24.2"
  }
}
