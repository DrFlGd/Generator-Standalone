{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vostok Labs Standalone",
  "version": "0.6.0",
  "identifier": "com.drflgd.vostoklabsstandalone",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vostok Labs Standalone",
        "width": 1480,
        "height": 960,
        "minWidth": 950,
        "minHeight": 630,
        "resizable": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
